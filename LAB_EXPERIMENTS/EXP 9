import re
def pos_tagger(word):
    if re.match(r"^[Tt]he$|^[Aa]n?$", word):
        return "Determiner"
    elif re.match(r".*ing$", word):
        return "Verb"
    elif re.match(r".*ly$", word):
        return "Adverb"
    elif re.match(r".*ous$|.*ful$", word):
        return "Adjective"
    else:
        return "Noun"

words = ["The", "playing", "quickly", "beautiful", "student"]

print("Rule-Based POS Tagging:")

for word in words:
    print(word, ":", pos_tagger(word))
