from nltk.stem import PorterStemmer
stemmer = PorterStemmer()
words = [
    "playing",
    "played",
    "plays",
    "connected",
    "connection",
    "studies",
    "running",
    "happiness"
]
print("Porter Stemming Results:")
for word in words:
    stem = stemmer.stem(word)
    print(word, "->", stem)
