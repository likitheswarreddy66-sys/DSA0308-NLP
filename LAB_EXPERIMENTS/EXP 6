import random
text = "I love python programming. I love machine learning. Python is easy."
words = text.lower().replace(".", "").split()
bigrams = {}

for i in range(len(words) - 1):
    word = words[i]
    next_word = words[i + 1]
    if word not in bigrams:
        bigrams[word] = []
    bigrams[word].append(next_word)
current_word = "i"
result = [current_word]
for i in range(8):
    if current_word in bigrams:
        current_word = random.choice(bigrams[current_word])
        result.append(current_word)
    else:
        break
print("Generated Text:")
print(" ".join(result))
